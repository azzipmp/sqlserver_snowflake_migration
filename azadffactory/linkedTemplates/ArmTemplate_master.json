{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azadffactory"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_snowflake_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_snowflake'"
		},
		"ls_sqlserver_local_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqlserver_local'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azsqlserverdata.dfs.core.windows.net/"
		},
		"ls_snowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "MIGRATION"
		},
		"ls_snowflake_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"ls_snowflake_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "BIJEDVR-WXC85777.snowflakecomputing.com"
		},
		"ls_sqlserver_local_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "AZ\\SQLEXPRESS"
		},
		"ls_sqlserver_local_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksDW2022"
		},
		"ls_sqlserver_local_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azadffactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_snowflake_password": {
						"value": "[parameters('ls_snowflake_password')]"
					},
					"ls_sqlserver_local_password": {
						"value": "[parameters('ls_sqlserver_local_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_snowflake_properties_typeProperties_database": {
						"value": "[parameters('ls_snowflake_properties_typeProperties_database')]"
					},
					"ls_snowflake_properties_typeProperties_role": {
						"value": "[parameters('ls_snowflake_properties_typeProperties_role')]"
					},
					"ls_snowflake_properties_typeProperties_host": {
						"value": "[parameters('ls_snowflake_properties_typeProperties_host')]"
					},
					"ls_sqlserver_local_properties_typeProperties_server": {
						"value": "[parameters('ls_sqlserver_local_properties_typeProperties_server')]"
					},
					"ls_sqlserver_local_properties_typeProperties_database": {
						"value": "[parameters('ls_sqlserver_local_properties_typeProperties_database')]"
					},
					"ls_sqlserver_local_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqlserver_local_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}